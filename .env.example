# Copy this file to .env.local and fill in the two values from your Supabase
# project: Studio -> Project Settings -> API.
#
# Both of these are safe to ship in the browser bundle. The anon (or
# publishable) key carries no privileges of its own — every request it makes is
# still evaluated against the Row Level Security policies in schema.sql, which
# allow SELECT to everyone and writes only to rows passing public.is_admin().
#
# NEVER put the service_role / sb_secret_ key here. It bypasses RLS entirely,
# and anything prefixed VITE_ is compiled into the JavaScript served to every
# visitor. src/lib/supabase.ts refuses to start if it detects one.
#
# .env.local is gitignored. Do not commit it.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
